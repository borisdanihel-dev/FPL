__pycache__/
*.pyc

# the working export in the repository root is regenerated on every run; the
# dated point-in-time copies in exports/ are tracked (anchored: root only)
/fpl_export_gw*.json

# local-only artefacts of fpl_run.bat: its run logs and the status scratch file.
# The Actions runner logs to logs/, which is tracked, as are reports/*.txt
reports/run_*.log
reports/record_status.tmp

# downloaded historical data (regenerable, ~6.5MB)
historical/

# local point-in-time copies, database backups, files waiting for Drive
archive/
backup/
outbox/

# a locked log leaves that run's forecasts here
projection_log.csv.tmp
